# Copy this file to .env (already gitignored — never commit real credentials):
#   copy .env.example .env
# Then edit .env and fill in the values below. Do not add "#" in front of
# any line in .env — only this .example file uses comments.

# --- Recipient ---
# For multiple recipients, separate addresses with a comma (no spaces
# needed, but they're fine too) — e.g.:
#   MAIL_TO=prachi@tekyz.com,gayathri@tekyz.com
MAIL_TO=prachi@tekyz.com
MAIL_FROM=

# --- SMTP settings ---
# Use an app-specific password, never your normal account password.
#
# Google Workspace / Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   Generate an app password at https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification enabled first)
#
# Microsoft 365 / Outlook:
#   SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#
# Any other provider: use the SMTP host/port they give you.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
