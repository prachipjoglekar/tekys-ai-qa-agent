{
  "name": "tekyz-ai-qa-agent",
  "version": "0.1.0",
  "description": "Automated QA and security monitoring for tekyz.com",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke",
    "test:functional": "playwright test --project=functional",
    "test:security": "playwright test --project=security",
    "test:regression": "playwright test --project=regression",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "typescript": "^5.5.0"
  }
}
